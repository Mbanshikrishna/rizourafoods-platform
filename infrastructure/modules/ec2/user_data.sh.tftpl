#!/bin/bash
set -euo pipefail

dnf update -y
dnf install -y docker awscli python3
systemctl enable --now docker
systemctl enable --now amazon-ssm-agent || true
usermod -aG docker ec2-user || true

mkdir -p /opt/rizourafoods

cat >/usr/local/bin/render_rizoura_env.py <<'PY'
import json
import sys

payload = json.loads(open(sys.argv[1], "r", encoding="utf-8").read())
for key, value in payload.items():
    if value is None:
        continue
    print(f"{key}={value}")
PY

for attempt in $(seq 1 20); do
  if aws secretsmanager get-secret-value \
    --region ${aws_region} \
    --secret-id ${app_config_secret_arn} \
    --query SecretString \
    --output text >/opt/rizourafoods/app-config.json; then
    break
  fi

  if [ "${attempt}" -eq 20 ]; then
    echo "Unable to fetch application secret after multiple attempts"
    exit 1
  fi

  sleep 15
done

python3 /usr/local/bin/render_rizoura_env.py /opt/rizourafoods/app-config.json >/opt/rizourafoods/.env

aws ecr get-login-password --region ${aws_region} | docker login --username AWS --password-stdin ${ecr_registry}
docker pull ${api_image}
docker rm -f rizourafoods-api || true

docker run -d \
  --name rizourafoods-api \
  --restart unless-stopped \
  --env-file /opt/rizourafoods/.env \
  --log-driver awslogs \
  --log-opt awslogs-region=${aws_region} \
  --log-opt awslogs-group=${cloudwatch_log_group_name} \
  --log-opt awslogs-stream=$(hostname)-api \
  -p 3000:3000 \
  ${api_image} sh -c "npx prisma migrate deploy && node dist/server.js"
