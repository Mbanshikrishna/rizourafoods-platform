generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
  SALES
  PROCUREMENT
  WAREHOUSE
  FINANCE
  DISTRIBUTOR
}

enum InquiryType {
  EXPORT
  BULK_ORDER
  CONTACT
  DISTRIBUTOR
  PRIVATE_LABEL
  GENERAL
}

enum CustomerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}
enum BusinessProfileStatus {
  PENDING
  APPROVED
  REJECTED
}
enum BusinessType {
  RESTAURANT
  HOTEL
  CAFE
  CATERER
  CLOUD_KITCHEN
  DISTRIBUTOR
  INSTITUTION
  RETAILER
  OTHER
}
enum ContactRole {
  OWNER
  PROCUREMENT
  PURCHASE_MANAGER
  CHEF
  ACCOUNTS
  OPERATIONS
  OTHER
}
enum AddressType {
  BILLING
  DELIVERY
  WAREHOUSE
  OFFICE
  OTHER
}
enum CrmActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  SAMPLE_DISCUSSION
  PRICE_DISCUSSION
  FOLLOW_UP
  NOTE
}
enum QuoteStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}
enum SampleStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  DISPATCHED
  DELIVERED
  REJECTED
  CANCELLED
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}
enum DistributorApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}
enum PriceTier {
  RETAIL
  B2B
  DISTRIBUTOR
  EXPORT
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @db.Text
  shortDescription String?
  category    String
  subcategory String?
  imageUrl    String?
  origin String?
  ingredients String?
  unit String?
  packSizes String[] @default([])
  moq Decimal? @db.Decimal(12, 2)
  availability String?
  leadTimeDays Int?
  b2bEligible Boolean @default(true)
  badges String[] @default([])
  specifications String? @db.Text
  storageInstructions String? @db.Text
  usage String? @db.Text
  quoteLines QuoteLine[]
  sampleLines SampleRequestLine[]
  prices ProductPrice[]
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category, status])
  @@index([createdAt])
}

model Customer {
  id String @id @default(cuid())
  name String
  email String @unique
  phone String?
  passwordHash String
  status CustomerStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  businessProfile BusinessProfile?
  addresses Address[]
  contacts CustomerContact[]
  crmActivities CrmActivity[]
  refreshTokens CustomerRefreshToken[]
  quotes Quote[]
  samples SampleRequest[]
  orders Order[]
  @@index([status])
}

model BusinessProfile {
  id String @id @default(cuid())
  customerId String @unique
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessName String
  tradingName String?
  businessType BusinessType
  gstNumber String? @unique
  registrationNumber String? @unique
  panNumber String?
  website String?
  phone String?
  email String?
  address String?
  city String
  state String
  pincode String
  country String @default("India")
  estimatedMonthlyVolume String?
  currentSupplier String?
  monthlyRiceConsumption String?
  monthlyFoodProcurement String?
  preferredPackSize String?
  paymentTerms String?
  deliveryRequirements String? @db.Text
  deliveryFrequency String?
  categoriesOfInterest String[] @default([])
  status BusinessProfileStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([businessType, status])
}

model Address {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label String?
  type AddressType @default(DELIVERY)
  line1 String
  line2 String?
  city String
  state String
  pincode String
  country String @default("India")
  phone String?
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId])
  @@index([customerId, isDefault])
}

model CustomerContact {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name String
  designation String?
  role ContactRole @default(OTHER)
  phone String?
  email String?
  isPrimary Boolean @default(false)
  crmActivities CrmActivity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, isPrimary])
}

model CrmActivity {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactId String?
  contact CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  type CrmActivityType
  subject String
  details String? @db.Text
  createdById String
  createdBy AdminUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([contactId])
}

model CustomerRefreshToken {
  id String @id @default(cuid())
  tokenHash String @unique
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([customerId, expiresAt])
}

model Quote {
  id String @id @default(cuid())
  quoteNumber String @unique
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contactName String
  company String?
  email String
  phone String?
  deliveryAddress String?
  status QuoteStatus @default(SUBMITTED)
  notes String? @db.Text
  validUntil DateTime?
  lines QuoteLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId, status])
}

model QuoteLine {
  id String @id @default(cuid())
  quoteId String
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Decimal @db.Decimal(12, 2)
  unit String
  packSize String?
  requestedPrice Decimal? @db.Decimal(12, 2)
  quotedPrice Decimal? @db.Decimal(12, 2)
  notes String? @db.Text
}

model SampleRequest {
  id String @id @default(cuid())
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contactName String
  company String?
  email String
  phone String?
  businessType String?
  expectedMonthlyVolume String?
  intendedUse String?
  deliveryAddress String?
  status SampleStatus @default(REQUESTED)
  lines SampleRequestLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId, status])
}

model SampleRequestLine {
  id String @id @default(cuid())
  sampleRequestId String
  sampleRequest SampleRequest @relation(fields: [sampleRequestId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  requestedQuantity Decimal @db.Decimal(12, 2)
  unit String
}

model ProductPrice {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tier PriceTier
  minQuantity Decimal @db.Decimal(12, 2)
  maxQuantity Decimal? @db.Decimal(12, 2)
  unit String
  unitPrice Decimal @db.Decimal(12, 2)
  currency String @default("INR")
  validFrom DateTime @default(now())
  validUntil DateTime?
  @@index([productId, tier])
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status OrderStatus @default(PENDING)
  subtotal Decimal @db.Decimal(12, 2)
  tax Decimal @db.Decimal(12, 2) @default(0)
  shipping Decimal @db.Decimal(12, 2) @default(0)
  total Decimal @db.Decimal(12, 2)
  currency String @default("INR")
  billingAddress String?
  shippingAddress String?
  notes String? @db.Text
  lines OrderLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId, status])
}

model OrderLine {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  productName String
  quantity Decimal @db.Decimal(12, 2)
  unit String
  packSize String?
  unitPrice Decimal @db.Decimal(12, 2)
  tax Decimal @db.Decimal(12, 2) @default(0)
  lineTotal Decimal @db.Decimal(12, 2)
}

model DistributorApplication {
  id String @id @default(cuid())
  name String
  company String
  email String
  phone String
  gstNumber String?
  territory String
  city String
  state String
  existingBusiness String?
  distributionNetwork String?
  estimatedMonthlyVolume String?
  productsInterested String?
  message String? @db.Text
  status DistributorApplicationStatus @default(SUBMITTED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model ExportInquiry {
  id String @id @default(cuid())
  company String
  buyerName String
  email String
  phone String?
  country String
  destination String?
  products String
  quantity String
  packaging String?
  privateLabel Boolean @default(false)
  message String? @db.Text
  createdAt DateTime @default(now())
  @@index([country, createdAt])
}

model Inquiry {
  id          String      @id @default(cuid())
  name        String
  email       String
  company     String?
  country     String?
  phone       String?
  inquiryType InquiryType @default(GENERAL)
  message     String      @db.Text
  createdAt   DateTime    @default(now())

  @@index([inquiryType, createdAt])
  @@index([email])
}

model Blog {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  content       String     @db.Text
  featuredImage String?
  status        BlogStatus @default(DRAFT)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, createdAt])
}

model AdminUser {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         UserRole       @default(EDITOR)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  crmActivities CrmActivity[]

  @@index([role])
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
